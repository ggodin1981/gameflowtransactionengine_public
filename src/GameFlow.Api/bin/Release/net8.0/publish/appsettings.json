{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Postgres": {
    "ConnectionString": ""
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "QueueName": "gameflow.transaction.commands"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "gameflow:"
  },
  "SignalRService": {
    "BaseUrl": "http://localhost:5053/",
    "ApiKey": "local-dev-key"
  },
  "DemoMode": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
